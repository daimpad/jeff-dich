{
  "name": "jeff-dich",
  "private": true,
  "version": "0.1.0",
  "description": "Design-Artefakte (Animationen, interaktive HTML/JS) zum Einbinden in WordPress",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "new": "node scripts/new-artifact.mjs",
    "build": "vite build && node scripts/build-embeds.mjs",
    "build:plugin": "node scripts/zip-plugin.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/alata": "^5.3.0",
    "@fontsource/blaka": "^5.3.0",
    "gsap": "^3.15.1",
    "lottie-web": "^5.13.0",
    "three": "^0.187.0"
  }
}
